# Sao chép file này thành .env rồi điền giá trị của dự án Supabase.
# Lấy tại: Supabase > Project Settings > API
# Lưu ý: anon key là khóa công khai, nó nằm trong mã nguồn trang web sau khi build.
# An toàn nằm ở chính sách RLS của bảng (chỉ cho ghi, không cho đọc), không nằm ở việc giấu khóa.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Tên bảng, để trống sẽ dùng "lookups"
VITE_SUPABASE_TABLE=lookups
